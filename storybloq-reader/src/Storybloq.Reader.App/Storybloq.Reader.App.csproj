<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Storybloq.Reader.App</RootNamespace>
    <AssemblyName>Storybloq.Reader.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>

    <!--
      Unpackaged, self-contained deployment: `dotnet publish` emits a plain folder with a
      runnable .exe. No MSIX, and therefore no code-signing certificate needed in CI - which
      is what lets the Windows job publish an artifact anyone can download and run.

      The cost is that APIs requiring package identity are unavailable, so settings go to
      %LOCALAPPDATA% rather than ApplicationData.Current, and the folder picker needs explicit
      HWND interop. Both are handled explicitly rather than discovered at runtime.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!--
      WinUI's XAML compiler generates partial classes that do not satisfy nullable analysis,
      so the solution-wide warnings-as-errors setting cannot apply to this project.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      MVVMTK0045 advises replacing [ObservableProperty] fields with partial properties so the
      CsWinRT generators can emit AOT-safe marshalling. Partial properties are C# 13, which is
      unavailable on .NET 8, and this app is neither trimmed nor AOT-compiled - so the advice
      cannot be taken and does not apply. Silenced deliberately to keep real warnings visible.
    -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Storybloq.Reader.Core\Storybloq.Reader.Core.csproj" />
    <ProjectReference Include="..\Storybloq.Reader.Platform\Storybloq.Reader.Platform.csproj" />
  </ItemGroup>

</Project>
