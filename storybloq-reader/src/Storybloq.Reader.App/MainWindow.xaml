<Window
    x:Class="Storybloq.Reader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Storybloq.Reader.App"
    xmlns:vm="using:Storybloq.Reader.App.ViewModels"
    xmlns:p="using:Storybloq.Reader.Platform.Presentation"
    Title="Storybloq Reader">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Project rail -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="16,16,16,8"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Projects" />

            <ListView
                x:Name="ProjectList"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectViewModel">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <InfoBadge
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Value="{x:Bind BadgeCount, Mode=OneWay}"
                                Visibility="{x:Bind local:XamlHelpers.Show(HasBadge), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Margin="12" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.AddProjectCommand}" Content="Add project…" />
                <Button
                    Command="{x:Bind ViewModel.RemoveProjectCommand}"
                    CommandParameter="{x:Bind ViewModel.SelectedProject, Mode=OneWay}"
                    Content="Remove" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Shown until the first project is added -->
            <StackPanel
                Grid.Row="1"
                Margin="48"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="No projects yet" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Add a folder containing a .story directory. Any folder inside the project will do — the reader walks up to find it."
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:XamlHelpers.ShowText(ViewModel.StatusMessage), Mode=OneWay}" />
            </StackPanel>

            <NavigationView
                x:Name="SectionNav"
                Grid.Row="0"
                Grid.RowSpan="2"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="Top"
                SelectionChanged="OnSectionSelectionChanged"
                Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Overview" Tag="Overview" />
                    <NavigationViewItem Content="Tickets" Tag="Tickets" />
                    <NavigationViewItem Content="Issues" Tag="Issues" />
                    <NavigationViewItem Content="Handovers" Tag="Handovers" />
                    <NavigationViewItem Content="Notes &amp; lessons" Tag="Knowledge" />
                    <NavigationViewItem Content="Attention" Tag="Attention" />
                </NavigationView.MenuItems>

                <Grid Margin="20,12,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Project header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedProject.Name, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedProject.Presentation.Summary, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Load problems: never silently swallowed -->
                    <InfoBar
                        Grid.Row="1"
                        Margin="0,0,0,12"
                        IsClosable="False"
                        IsOpen="True"
                        Message="Some files in .story could not be read. Everything else is still shown."
                        Severity="Warning"
                        Title="Load problems"
                        Visibility="{x:Bind ViewModel.DiagnosticsVisibility, Mode=OneWay}">
                        <InfoBar.Content>
                            <ItemsControl
                                Margin="0,8,0,8"
                                ItemsSource="{x:Bind ViewModel.SelectedProject.Presentation.Diagnostics, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:DiagnosticRow">
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                            <Run Text="{x:Bind File}" />
                                            <Run Text=" — " />
                                            <Run Text="{x:Bind Message}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </InfoBar.Content>
                    </InfoBar>

                    <!-- Overview -->
                    <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.OverviewVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Current phase" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedProject.Presentation.CurrentPhase, Mode=OneWay}" />
                                <ProgressBar Maximum="1" Value="{x:Bind ViewModel.SelectedProject.Presentation.Progress, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Roadmap" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedProject.Presentation.Phases, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="p:PhaseRow">
                                            <Grid Margin="0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Summary}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Counts}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Status}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Uncleared blockers" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedProject.Presentation.Blockers, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="p:BlockerRow">
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Note}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tickets -->
                    <ListView
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.SelectedProject.Presentation.Tickets, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.TicketsVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="p:TicketRow">
                                <Grid Margin="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Id}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind local:XamlHelpers.Show(IsBlocked)}">
                                            <Run Text="Blocked by" />
                                            <Run Text="{x:Bind BlockedBy}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind Status}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Phase}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Issues -->
                    <ListView
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.SelectedProject.Presentation.Issues, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.IssuesVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="p:IssueRow">
                                <Grid Margin="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Id}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Location}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind Severity}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Status}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Handovers -->
                    <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.HandoversVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListView
                            x:Name="HandoverList"
                            Grid.Column="0"
                            ItemsSource="{x:Bind ViewModel.SelectedProject.Presentation.Handovers, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedHandover, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="p:HandoverRow">
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Date}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ScrollViewer Grid.Column="1" Padding="16,0,0,0">
                            <TextBlock
                                FontFamily="Consolas"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.HandoverContent, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Notes and lessons -->
                    <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.KnowledgeVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Notes" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedProject.Presentation.Notes, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:NoteRow">
                                        <StackPanel Margin="0,6">
                                            <TextBlock Text="{x:Bind Title}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Tags}"
                                                Visibility="{x:Bind local:XamlHelpers.ShowText(Tags)}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Lessons" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedProject.Presentation.Lessons, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:LessonRow">
                                        <StackPanel Margin="0,6">
                                            <TextBlock Text="{x:Bind Title}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Content}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Reinforcements}"
                                                Visibility="{x:Bind local:XamlHelpers.ShowText(Reinforcements)}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Attention, across every open project -->
                    <ListView
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.Attention, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.AttentionVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="p:AttentionRow">
                                <Grid Margin="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Width="80"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Kind}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ProjectName}"
                                        TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Detail}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
